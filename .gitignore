# ==============================
# Terraform .gitignore Template
# ==============================

# The .terraform/ directory contains downloaded provider plugins and modules.
# These are environment-specific and can be regenerated by running `terraform init`.
.terraform/

# Terraform lock file — ensures consistent provider versions.
# Usually, you should commit this if you want to lock provider versions for the team.
# However, some teams ignore it to always fetch the latest versions.
.terraform.lock.hcl

# Terraform state files — store the current infrastructure state.
# These files contain sensitive data (like access keys, resource IDs, etc.),
# so they should NEVER be committed to Git.
terraform.tfstate
terraform.tfstate.*

# Crash log generated when Terraform encounters a crash.
# Useful for debugging locally but not needed in version control.
crash.log

# Variable definition files that might contain secrets or environment-specific values.
# Example: credentials, passwords, or region info.
*.tfvars

# Local override files (used for temporary local testing).
# Terraform merges these automatically but they should not be shared.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# User-specific Terraform CLI configuration files.
# These store local CLI settings and should not be shared in repositories.
.terraformrc
terraform.rc

